---
import '../styles/global.css';
import { languages, languageNames, sections, legalPages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  // Path after the language prefix, used by the language switcher (e.g. "solutions").
  path?: string;
  // Full-width main: the page lays out its own sections (home page).
  wide?: boolean;
}

const { lang, title, description, path = '', wide = false } = Astro.props;
const href = (l: Lang, p: string) => `/${l}/${p ? `${p}/` : ''}`;
const pageTitle = title === 'RheinWeg' ? title : `${title} | RheinWeg`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const locales: Record<Lang, string> = { de: 'de_DE', en: 'en_US', zh: 'zh_CN' };
const desc = description ?? t(lang, 'home.tagline');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={new URL(href(l as Lang, path), Astro.site)} />
    ))}
    <meta property="og:site_name" content="RheinWeg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locales[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="RheinWeg — Brücke zwischen Deutschland und China: Handel, Software und KI." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Language choice shared with aiblocks.rheinwegde.de through one cookie on
      // the parent domain. Values are AiBlocks' Locale ids, so Chinese is "zh-CN".
      // A remembered choice wins over the URL: open the same page in that language.
      // Without a cookie, remember the language of this page.
      (function () {
        var NAME = 'RHEINWEG_LOCALE';
        var toCookie = { de: 'de', en: 'en', zh: 'zh-CN' };
        var fromCookie = { de: 'de', en: 'en', 'zh-CN': 'zh' };
        var domain = /(^|\.)rheinwegde\.de$/.test(location.hostname) ? '; domain=.rheinwegde.de' : '';
        window.rwSetLocale = function (lang) {
          document.cookie = NAME + '=' + toCookie[lang] + '; path=/; max-age=31536000; samesite=lax' + domain;
        };
        function sync() {
          var page = document.documentElement.lang;
          var m = document.cookie.match(/(?:^|; )RHEINWEG_LOCALE=([^;]*)/);
          var want = m && fromCookie[m[1]];
          if (!want) return window.rwSetLocale(page);
          var prefix = /^\/(de|en|zh)(?=\/|$)/;
          if (want !== page && prefix.test(location.pathname)) {
            location.replace(location.pathname.replace(prefix, '/' + want) + location.search + location.hash);
          }
        }
        sync();
        // Pages restored from the back/forward cache do not rerun this script.
        addEventListener('pageshow', function (e) { if (e.persisted) sync(); });
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-900 antialiased">
    <header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/85 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href={href(lang, '')} class="flex items-center gap-2 text-lg font-semibold tracking-tight">
          <svg aria-hidden="true" class="h-7 w-7" viewBox="0 0 32 32">
            <rect width="32" height="32" rx="8" class="fill-brand-600" />
            <path d="M6 20c4-6 8 2 12-4s6-4 8-2" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" />
          </svg>
          RheinWeg
        </a>
        <ul class="order-last flex w-full flex-wrap gap-x-5 gap-y-1 text-sm text-slate-600 lg:order-none lg:w-auto lg:flex-1">
          {sections.map((s) => (
            <li><a href={href(lang, s)} class="hover:text-slate-900">{t(lang, `nav.${s}`)}</a></li>
          ))}
        </ul>
        <a href={href(lang, 'contact')} class="ml-auto rounded-lg bg-brand-600 px-3.5 py-1.5 text-sm font-medium text-white hover:bg-brand-700">{t(lang, 'contact')}</a>
      </nav>
    </header>

    <main class={wide ? 'flex-1' : 'mx-auto w-full max-w-5xl flex-1 px-4 py-10'}>
      <slot />
    </main>

    <footer class="border-t border-slate-200 text-sm text-slate-500">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-6">
        <span>© {new Date().getFullYear()} RheinWeg</span>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={href(lang, 'contact')} class="hover:underline">{t(lang, 'contact')}</a>
          {legalPages.map((p) => (
            <a href={href(lang, p)} class="hover:underline">{t(lang, `nav.${p}`)}</a>
          ))}
          <button
            type="button"
            data-lang-open
            aria-haspopup="dialog"
            class="inline-flex items-center gap-1.5 rounded px-2 text-slate-900 hover:bg-slate-100"
          >
            <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
            </svg>
            <span class="sr-only">{t(lang, 'lang.label')} </span>
            <span lang={lang}>{languages[lang]}</span>
          </button>
        </div>
      </div>
    </footer>

    <dialog
      id="lang-dialog"
      aria-labelledby="lang-dialog-title"
      class="m-auto w-[min(24rem,calc(100vw-2rem))] rounded-xl border border-slate-200 p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/30"
    >
      <div class="flex items-center justify-between px-5 pt-5 pb-3">
        <h2 id="lang-dialog-title" class="text-lg font-semibold">{t(lang, 'lang.title')}</h2>
        <button type="button" data-lang-close aria-label={t(lang, 'lang.close')} class="rounded p-1 text-slate-500 hover:bg-slate-100 hover:text-slate-900">
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <ul class="px-2 pb-2">
        {Object.entries(languages).map(([l, label]) => (
          <li>
            <a
              href={href(l as Lang, path)}
              hreflang={l}
              lang={l}
              data-lang-choice={l}
              aria-current={l === lang ? 'true' : undefined}
              class="flex items-center justify-between rounded-lg px-3 py-2 hover:bg-slate-100 aria-[current]:bg-slate-50"
            >
              <span class="flex flex-col">
                <span>{label}</span>
                <span lang={lang} class="text-sm text-slate-500">{languageNames[lang][l as Lang]}</span>
              </span>
              {l === lang && (
                <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L19 7" /></svg>
              )}
            </a>
          </li>
        ))}
      </ul>
    </dialog>

    <script>
      const dialog = document.getElementById('lang-dialog') as HTMLDialogElement;
      document.querySelector('[data-lang-open]')?.addEventListener('click', () => dialog.showModal());
      dialog.querySelector('[data-lang-close]')?.addEventListener('click', () => dialog.close());
      // Close when clicking the backdrop (outside the dialog box).
      dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
      // Remember the picked language before leaving, so the next page keeps it.
      dialog.querySelectorAll<HTMLElement>('[data-lang-choice]').forEach((a) => {
        a.addEventListener('click', () => (window as any).rwSetLocale(a.dataset.langChoice));
      });
    </script>
  </body>
</html>
