---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n/ui';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map((page) => {
    // id is "{lang}/{slug}", where slug may be nested (e.g. "en/outsourcing/websites").
    const [lang, ...rest] = page.id.split('/');
    const slug = rest.join('/');
    return { params: { lang, slug }, props: { page } };
  });
}

type Page = CollectionEntry<'pages'>;
const { page } = Astro.props;
const { lang, slug } = Astro.params;
const pages = await getCollection('pages');

const url = (id: string) => `/${id}/`;
const childrenOf = (id: string) =>
  pages
    .filter((p) => p.id.startsWith(`${id}/`) && !p.id.slice(id.length + 1).includes('/'))
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0) || a.id.localeCompare(b.id));
// A container links to its first leaf.
const leafOf = (p: Page): Page => {
  const first = childrenOf(p.id)[0];
  return first ? leafOf(first) : p;
};

const target = leafOf(page);
const isRedirect = target !== page;

// Tabs: section children in the left sidebar; a tab's own children as top tabs.
const [section, tab] = slug!.split('/');
const sectionPage = pages.find((p) => p.id === `${lang}/${section}`);
const sideTabs = tab ? childrenOf(`${lang}/${section}`) : [];
const topTabs = tab ? childrenOf(`${lang}/${section}/${tab}`) : [];
const isActive = (p: Page) => page.id === p.id || page.id.startsWith(`${p.id}/`);

const { Content } = await render(page);
---

{isRedirect ? (
  <html lang={lang}>
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0; url=${url(target.id)}`} />
      <link rel="canonical" href={url(target.id)} />
      <title>{page.data.title}</title>
    </head>
    <body><a href={url(target.id)}>{target.data.title}</a></body>
  </html>
) : (
  <Base lang={lang as Lang} title={page.data.title} description={page.data.description} path={slug}>
    {sideTabs.length > 0 ? (
      <div class="flex flex-col gap-8 md:flex-row">
        <aside class="md:w-60 md:shrink-0">
          <p class="text-xs font-medium uppercase tracking-widest text-slate-400">{sectionPage?.data.title}</p>
          <ul class="mt-3 flex flex-wrap gap-1 md:flex-col">
            {sideTabs.map((p) => (
              <li>
                <a
                  href={url(leafOf(p).id)}
                  aria-current={isActive(p) ? 'page' : undefined}
                  class={`block rounded-md px-3 py-2 text-sm ${isActive(p) ? 'bg-slate-100 font-semibold' : 'text-slate-600 hover:bg-slate-50'}`}
                >{p.data.title}</a>
              </li>
            ))}
          </ul>
        </aside>
        <article class="min-w-0 max-w-3xl flex-1">
          {topTabs.length > 0 && (
            <ul class="mb-6 flex gap-4 overflow-x-auto border-b border-slate-200 text-sm">
              {topTabs.map((p) => (
                <li class="shrink-0">
                  <a
                    href={url(p.id)}
                    aria-current={isActive(p) ? 'page' : undefined}
                    class={`-mb-px block border-b-2 py-2 ${isActive(p) ? 'border-slate-900 font-semibold' : 'border-transparent text-slate-500 hover:text-slate-900'}`}
                  >{p.data.title}</a>
                </li>
              ))}
            </ul>
          )}
          <h1 class="text-3xl font-bold">{page.data.title}</h1>
          <div class="content mt-6 space-y-4">
            <Content />
          </div>
        </article>
      </div>
    ) : (
      <article class="max-w-3xl">
        <h1 class="text-3xl font-bold">{page.data.title}</h1>
        <div class="content mt-6 space-y-4">
          <Content />
        </div>
      </article>
    )}
  </Base>
)}
