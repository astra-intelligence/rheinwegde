---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { contactEmail, contactPhone, languages, sections, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const href = (p: string) => `/${lang}/${p ? `${p}/` : ''}`;

// Featured: the first three workshops (by `order`) that have a description.
const workshops = (await getCollection('pages'))
  .filter((p) => p.id.startsWith(`${lang}/workshops/`) && p.data.description)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
  .slice(0, 3)
  .map((p) => ({ ...p, slug: p.id.split('/').pop() }));

// Hero staff: five parallel wavy lines (the Rhine) carrying the opening phrase of a well-known
// tune per language. Notes: [pos, beats]; pos = half-steps above the middle line B4 (treble clef),
// beats: 1 = quarter. All picked in keys that need no accidentals on the notes used.
// `style` picks the arrangement played by the button; `chords` = [note names, beats], lowest note first.
type Song = {
  title: string; meter: number; pickup: number; tune: [number, number][]; beams: number[][];
  style: 'orchestra' | 'guqin'; chords: [string[], number][];
};
const songs: Record<Lang, Song> = {
  // Beethoven, Ode an die Freude (G major): "Freude, schöner Götterfunken".
  de: {
    title: 'Ludwig van Beethoven: Ode an die Freude',
    meter: 4, pickup: 0, beams: [],
    tune: [[0, 1], [0, 1], [1, 1], [2, 1], [2, 1], [1, 1], [0, 1], [-1, 1], [-2, 1], [-2, 1], [-1, 1], [0, 1], [0, 1.5], [-1, 0.5], [-1, 2]],
    style: 'orchestra',
    chords: [[['G2', 'G3', 'B3', 'D4'], 4], [['D3', 'F#3', 'A3', 'D4'], 4], [['G2', 'G3', 'B3', 'D4'], 4], [['G2', 'G3', 'B3', 'D4'], 2], [['D2', 'F#3', 'A3', 'D4'], 2]],
  },
  // Auld Lang Syne (G major): "Should auld acquaintance be forgot, and never brought to mind".
  en: {
    title: 'Auld Lang Syne',
    meter: 4, pickup: 1, beams: [],
    tune: [[-5, 1], [-2, 1.5], [-2, 0.5], [-2, 1], [0, 1], [-1, 1.5], [-2, 0.5], [-1, 1], [0, 1], [-2, 1.5], [-2, 0.5], [0, 1], [2, 1], [3, 2]],
    style: 'orchestra',
    chords: [[['D3', 'A3', 'D4'], 1], [['G2', 'G3', 'B3', 'D4'], 4], [['D3', 'F#3', 'A3', 'D4'], 4], [['G2', 'G3', 'B3', 'D4'], 4], [['C3', 'G3', 'C4', 'E4'], 2]],
  },
  // 古琴曲《梅花三弄》 theme (1=F): 1 55 | 5. 32 | 1 55 | 5. 32 | 1 (musicology.cn, reviews_6884).
  zh: {
    title: '古琴曲《梅花三弄》',
    meter: 2, pickup: 0, beams: [[1, 2], [4, 5], [7, 8], [10, 11]],
    tune: [[-3, 1], [1, 0.5], [1, 0.5], [1, 1.5], [-1, 0.25], [-2, 0.25], [-3, 1], [1, 0.5], [1, 0.5], [1, 1.5], [-1, 0.25], [-2, 0.25], [-3, 2]],
    style: 'guqin',
    // Open-string drones (F and C) every other bar, a rolled F chord at the end.
    chords: [[['F2', 'C3'], 4], [['F2', 'C3'], 4], [['F2', 'C3', 'F3', 'C4'], 2]],
  },
};
const song = songs[lang];

const GAP = 12; // distance between staff lines
const STEM = 26;
const wave = (x: number) => 150 + 24 * Math.sin((x / 400) * 2 * Math.PI + 0.6);
const staffLines = [-2, -1, 0, 1, 2].map((i) => {
  const pts = Array.from({ length: 43 }, (_, k) => -10 + k * 10);
  return pts.map((x, k) => `${k ? 'L' : 'M'}${x} ${(wave(x) + i * GAP).toFixed(1)}`).join(' ');
});
const step = 350 / (song.tune.length - 1);
const notes = song.tune.map(([pos, beats], i) => {
  const x = 32 + i * step;
  return { x, y: wave(x) - pos * (GAP / 2), beats };
});
type Note = (typeof notes)[number];
const beams = song.beams.map((g) => g.map((i) => notes[i]));
const stemTop = (n: Note) => {
  const g = beams.find((grp) => grp.includes(n));
  if (!g) return n.y - STEM;
  const [a, z] = [g[0], g[g.length - 1]];
  return a.y - STEM + ((z.y - a.y) * (n.x - a.x)) / (z.x - a.x);
};
const flagged = notes.filter((n) => n.beats < 1 && !beams.some((g) => g.includes(n)));
// Bar lines halfway between notes, after the pickup and then every `meter` beats.
const bars: number[] = [];
notes.reduce((t, n, i) => {
  const end = t + n.beats;
  const onBar = end === song.pickup || (end > song.pickup && (end - song.pickup) % song.meter === 0);
  if (onBar && i < notes.length - 1) bars.push((n.x + notes[i + 1].x) / 2);
  return end;
}, 0);
// Sample file names in public/audio/<instrument>/: letter + octave, sharps spelled as flats (F#3 -> Gb3).
const noteName = (pos: number) => {
  const idx = 6 + pos;
  return 'CDEFGAB'[((idx % 7) + 7) % 7] + (4 + Math.floor(idx / 7));
};
const flatName = (name: string) => name.replace(/^([A-G])#/, (_, l: string) => ({ C: 'Db', D: 'Eb', F: 'Gb', G: 'Ab', A: 'Bb' })[l]!);
const melody = JSON.stringify(song.tune.map(([pos, beats]) => [noteName(pos), beats]));
const chords = JSON.stringify(song.chords.map(([names, beats]) => [names.map(flatName), beats]));
const playLabel = `${t(lang, 'home.play')}${lang === 'zh' ? '：' : ': '}${song.title}`;

// Outline icon per section (24x24, stroke).
const icons: Record<(typeof sections)[number], string> = {
  solutions: 'M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18',
  products: 'M4 7l8-4 8 4-8 4-8-4zM4 7v10l8 4 8-4V7M12 11v10',
  outsourcing: 'M8 8l-4 4 4 4M16 8l4 4-4 4M14 5l-4 14',
  workshops: 'M3 8l9-4 9 4-9 4-9-4zM7 10v5c0 1.5 2.5 3 5 3s5-1.5 5-3v-5',
  'social-responsibility': 'M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z',
  research: 'M10 3v6L5 18a2 2 0 0 0 2 3h10a2 2 0 0 0 2-3l-5-9V3M8 3h8M7.5 14h9',
};
---

<Base lang={lang} title={t(lang, 'home.title')} description={t(lang, 'home.tagline')} wide>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-slate-200">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 md:grid-cols-[1.15fr_1fr] md:py-24">
      <div>
        <p class="text-xs font-medium uppercase tracking-[0.2em] text-brand-600">{t(lang, 'home.eyebrow')}</p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.08] tracking-tight text-balance sm:text-5xl lg:text-6xl">
          {t(lang, 'home.headline')}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600">{t(lang, 'home.lead')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={href('contact')} class="rounded-lg bg-brand-600 px-5 py-3 font-medium text-white shadow-sm hover:bg-brand-700">
            {t(lang, 'home.cta.primary')}
          </a>
          <a href={href('workshops')} class="rounded-lg border border-slate-300 bg-white px-5 py-3 font-medium hover:border-slate-400">
            {t(lang, 'home.cta.secondary')} →
          </a>
        </div>
      </div>

      <!-- Visual: the Rhine as a five-line staff with notes, linking DE and CN -->
      <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-gradient-to-br from-brand-900 via-brand-700 to-brand-500 shadow-xl">
        <svg aria-hidden="true" class="absolute inset-0 h-full w-full" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
          {staffLines.map((d) => (
            <path d={d} fill="none" stroke="white" stroke-opacity="0.45" stroke-width="1.5" />
          ))}
          {bars.map((x) => (
            <line x1={x} y1={wave(x) - 2 * GAP} x2={x} y2={wave(x) + 2 * GAP} stroke="white" stroke-opacity="0.45" stroke-width="1.5" />
          ))}
          <g fill="white" stroke="white">
            {notes.map((n) => (
              <g data-note class="transition-opacity duration-150">
                <ellipse
                  cx={n.x} cy={n.y} rx="5.6" ry="4" transform={`rotate(-20 ${n.x} ${n.y})`}
                  fill={n.beats >= 2 ? 'none' : 'white'} stroke-width={n.beats >= 2 ? 1.6 : 0}
                />
                <line x1={n.x + 5.2} y1={n.y - 1} x2={n.x + 5.2} y2={stemTop(n)} stroke-width="1.4" />
                {(n.beats === 0.75 || n.beats === 1.5) && <circle cx={n.x + 10} cy={n.y - 2} r="1.6" stroke="none" />}
                {flagged.includes(n) && <path d={`M${n.x + 5.2} ${stemTop(n)} q 1 7 7 11`} fill="none" stroke-width="1.6" />}
              </g>
            ))}
            {beams.map((g) => {
              const [a, z] = [g[0], g[g.length - 1]];
              const beam = (dy: number) => `M${a.x + 5.2} ${stemTop(a) + dy} L${z.x + 5.2} ${stemTop(z) + dy} l0 3.5 L${a.x + 5.2} ${stemTop(a) + dy + 3.5} Z`;
              // Sixteenths get a second beam.
              return <path d={g.every((n) => n.beats === 0.25) ? `${beam(0)} ${beam(6)}` : beam(0)} stroke="none" />;
            })}
          </g>
        </svg>
        <div aria-hidden="true" class="absolute top-6 left-6 rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur">DE</div>
        <div aria-hidden="true" class="absolute top-6 right-6 rounded-lg bg-white/10 px-3 py-2 text-sm font-semibold text-white ring-1 ring-white/20 backdrop-blur">CN</div>
        <!-- The whole card starts the music; the controls appear once it has played. -->
        <button
          type="button"
          id="melody-start"
          data-melody={melody}
          data-chords={chords}
          data-style={song.style}
          aria-label={playLabel}
          title={playLabel}
          class="absolute inset-0 cursor-pointer rounded-2xl transition hover:bg-white/5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-inset"
        ></button>
        <label data-melody-control class="invisible absolute bottom-6 left-6 flex h-11 items-center gap-2.5 rounded-full bg-white/10 px-4 text-white opacity-0 ring-1 ring-white/20 backdrop-blur transition-opacity duration-500" title={t(lang, 'home.volume')}>
          <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H3v6h3l5 4V5zM15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" /></svg>
          <input id="melody-volume" type="range" min="0" max="1" step="0.05" value="0.8" aria-label={t(lang, 'home.volume')} class="h-1 w-28 cursor-pointer accent-white" />
        </label>
        <!-- Stop while playing, replay afterwards. -->
        <button
          type="button"
          id="melody-toggle"
          data-melody-control
          data-play-label={playLabel}
          data-stop-label={t(lang, 'home.stop')}
          aria-label={t(lang, 'home.stop')}
          title={t(lang, 'home.stop')}
          class="invisible absolute right-6 bottom-6 flex h-11 w-11 items-center justify-center rounded-full bg-white text-brand-700 opacity-0 shadow-lg ring-1 ring-white/40 transition hover:scale-105"
        >
          <svg aria-hidden="true" data-icon="play" class="ml-0.5 hidden h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.5v15l13-7.5z" /></svg>
          <svg aria-hidden="true" data-icon="stop" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2" /></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t(lang, 'home.services.title')}</h2>
      <p class="mt-3 text-lg text-slate-600">{t(lang, 'home.services.lead')}</p>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sections.map((s) => (
          <li>
            <a href={href(s)} class="group flex h-full flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-lg">
              <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                <svg aria-hidden="true" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={icons[s]} /></svg>
              </span>
              <span class="mt-5 text-lg font-semibold">{t(lang, `nav.${s}`)}</span>
              <span class="mt-2 flex-1 text-slate-600">{t(lang, `home.svc.${s}`)}</span>
              <span class="mt-5 text-sm font-medium text-brand-600 group-hover:text-brand-700">{t(lang, 'home.more')} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured workshops -->
  <section>
    <div class="mx-auto max-w-6xl px-4 py-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t(lang, 'home.workshops.title')}</h2>
          <p class="mt-3 max-w-2xl text-lg text-slate-600">{t(lang, 'home.workshops.lead')}</p>
        </div>
        <a href={href('workshops')} class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:border-slate-400">{t(lang, 'home.workshops.all')} →</a>
      </div>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {workshops.map((w) => (
          <li>
            <a href={`/${w.id}/`} class="group flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 transition hover:border-brand-200 hover:shadow-lg">
              <img src={`/images/workshops/${w.slug}.svg`} alt="" class="aspect-[16/9] w-full border-b border-slate-200 bg-brand-50 object-cover" loading="lazy" />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-semibold leading-snug group-hover:text-brand-700">{w.data.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-slate-600">{w.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why RheinWeg -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{t(lang, 'home.why.title')}</h2>
      <dl class="mt-10 grid gap-8 md:grid-cols-3">
        {([1, 2, 3] as const).map((i) => (
          <div class="border-l-2 border-brand-500 pl-5">
            <dt class="text-lg font-semibold">{t(lang, `home.why.${i}.title`)}</dt>
            <dd class="mt-2 text-slate-600">{t(lang, `home.why.${i}.text`)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="px-4 py-20">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 rounded-2xl bg-brand-900 px-8 py-12 text-white md:flex-row md:items-center md:px-12">
      <div>
        <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t(lang, 'home.final.title')}</h2>
        <p class="mt-2 text-brand-100">{t(lang, 'home.final.text')}</p>
        <p class="mt-4 text-sm text-brand-200">
          <a href={`mailto:${contactEmail}`} class="hover:text-white">{contactEmail}</a>
          <span class="mx-2">·</span>
          <a href={`tel:${contactPhone.replace(/\s/g, '')}`} class="hover:text-white">{contactPhone}</a>
        </p>
      </div>
      <a href={href('contact')} class="shrink-0 rounded-lg bg-white px-5 py-3 font-medium text-brand-900 hover:bg-brand-50">{t(lang, 'home.cta.primary')}</a>
    </div>
  </section>

  <script>
    // Play the hero staff's opening phrase from recorded instrument samples (FluidR3_GM, CC BY 3.0,
    // see public/audio/CREDITS.txt): a small orchestra (de, en) or koto and shakuhachi standing in
    // for guqin and xiao (zh). The music fades out from the last note on. Each note lights up while
    // it sounds. Samples load on the first click.
    const card = document.getElementById('melody-start') as HTMLButtonElement;
    const toggle = document.getElementById('melody-toggle') as HTMLButtonElement;
    const controls = [...document.querySelectorAll<HTMLElement>('[data-melody-control]')];
    const heads = [...document.querySelectorAll<SVGGElement>('[data-note]')];
    const melody: [string, number][] = JSON.parse(card.dataset.melody!);
    const chords: [string[], number][] = JSON.parse(card.dataset.chords!);
    const guqin = card.dataset.style === 'guqin';
    const FADE = 4; // seconds from the last note's onset to silence
    let ctx: AudioContext | undefined;
    let volume: GainNode | undefined; // listener's volume, kept across plays and changeable while playing
    let reverb: AudioBuffer | undefined;
    const samples = new Map<string, Promise<AudioBuffer>>();
    let playing = false;
    let run = 0; // bumped by every play and stop, so a stale play stops scheduling
    let master: GainNode | undefined;
    let timers: number[] = [];

    // Toggle shows stop while playing, play (replay) otherwise.
    const setPlaying = (on: boolean) => {
      playing = on;
      const label = on ? toggle.dataset.stopLabel! : toggle.dataset.playLabel!;
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
      toggle.querySelector('[data-icon="play"]')!.classList.toggle('hidden', on);
      toggle.querySelector('[data-icon="stop"]')!.classList.toggle('hidden', !on);
    };
    const finish = () => {
      timers.forEach(clearTimeout);
      timers = [];
      heads.forEach((h) => (h.style.opacity = ''));
      setPlaying(false);
    };
    const stop = () => {
      run++;
      if (master && ctx) {
        const now = ctx.currentTime;
        master.gain.cancelScheduledValues(now);
        master.gain.setValueAtTime(master.gain.value, now);
        master.gain.linearRampToValueAtTime(0, now + 0.3);
      }
      finish();
    };

    // Volume slider, remembered per browser.
    const slider = document.getElementById('melody-volume') as HTMLInputElement;
    try {
      const saved = localStorage.getItem('melody-volume');
      if (saved !== null) slider.value = saved;
    } catch {}
    slider.addEventListener('input', () => {
      if (volume) volume.gain.setTargetAtTime(Number(slider.value), volume.context.currentTime, 0.02);
      try {
        localStorage.setItem('melody-volume', slider.value);
      } catch {}
    });

    type Voice = { inst: string; note: string; t: number; len: number; level: number; attack: number; release: number; cutoff?: number };
    // zh opens with a rising pentatonic sweep (刮奏) before the melody.
    const SWEEP = ['F3', 'G3', 'A3', 'C4', 'D4', 'F4', 'G4', 'A4', 'C5'];
    const octaveUp = (note: string) => note.replace(/\d$/, (o) => String(Number(o) + 1));

    const load = (ac: AudioContext, path: string) => {
      if (!samples.has(path)) samples.set(path, fetch(`/audio/${path}.mp3`).then((r) => r.arrayBuffer()).then((b) => ac.decodeAudioData(b)));
      return samples.get(path)!;
    };

    // Hall reverb: decaying stereo noise.
    const makeReverb = (ac: AudioContext, secs: number) => {
      const buf = ac.createBuffer(2, ac.sampleRate * secs, ac.sampleRate);
      for (let c = 0; c < 2; c++) {
        const d = buf.getChannelData(c);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length) ** 3;
      }
      return buf;
    };

    // Voices with times in seconds from the start; also returns each melody note's onset.
    const arrange = (beat: number) => {
      const voices: Voice[] = [];
      const onsets: number[] = [];
      const lead = guqin ? SWEEP.length * 0.07 + 0.35 : 0;
      SWEEP.forEach((note, i) => {
        if (guqin) voices.push({ inst: 'koto', note, t: i * 0.07, len: 0.6, level: 0.2 + i * 0.03, attack: 0.005, release: 0.8, cutoff: 3200 });
      });
      const fadeAt = lead + melody.slice(0, -1).reduce((s, [, b]) => s + b * beat, 0);
      const end = fadeAt + FADE;
      let t = lead;
      chords.forEach(([names, beats], i) => {
        const last = i === chords.length - 1;
        const len = last ? end - t : beats * beat;
        names.forEach((note, k) => {
          if (guqin) voices.push({ inst: 'koto', note, t: t + k * (last ? 0.12 : 0.06), len, level: 0.45, attack: 0.005, release: 1.2, cutoff: 1800 });
          else if (k === 0) voices.push({ inst: 'contrabass', note, t, len, level: 0.6, attack: 0.03, release: 0.4 });
          else voices.push({ inst: 'strings', note, t, len, level: 0.22, attack: 0.15, release: 0.5 });
        });
        if (!guqin && (i === 0 || last)) voices.push({ inst: 'timpani', note: names[0], t, len: 2.5, level: 0.5, attack: 0.005, release: 0.5 });
        t += len;
      });
      t = lead;
      melody.forEach(([note, beats], i) => {
        const len = i === melody.length - 1 ? FADE : beats * beat;
        onsets.push(t);
        if (guqin) {
          // Koto darkened toward guqin; the shakuhachi (xiao) only joins on held notes.
          voices.push({ inst: 'koto', note, t, len, level: 0.85, attack: 0.005, release: 1.2, cutoff: 2600 });
          if (beats >= 1) voices.push({ inst: 'shakuhachi', note, t: t + 0.06, len, level: 0.14, attack: 0.25, release: 0.5, cutoff: 2200 });
        } else {
          voices.push({ inst: 'strings', note, t, len, level: 0.55, attack: 0.04, release: 0.3 });
          voices.push({ inst: 'flute', note: octaveUp(note), t, len, level: 0.22, attack: 0.04, release: 0.3 });
        }
        t += len;
      });
      return { voices, onsets, fadeAt, end };
    };

    const play = async () => {
      if (playing) return;
      setPlaying(true);
      const id = ++run;
      controls.forEach((c) => c.classList.remove('invisible', 'opacity-0'));
      if (!ctx) {
        ctx = new AudioContext();
        volume = ctx.createGain();
        volume.gain.value = Number(slider.value);
        volume.connect(ctx.destination);
      }
      reverb ??= makeReverb(ctx, 2.8);
      const ac = ctx;
      const { voices, onsets, fadeAt, end } = arrange(guqin ? 0.66 : 0.55); // seconds per quarter note
      const buffers = await Promise.all(voices.map((v) => load(ac, `${v.inst}/${v.note}`)));
      if (id !== run) return; // stopped while loading
      const start = ac.currentTime + 0.05;

      // Signal chain: voices -> master (fade) -> dry + hall reverb -> compressor -> volume -> speakers.
      const bus = (master = ac.createGain());
      const lift = guqin ? 4 : 2.5; // samples are quiet; match the three songs' loudness
      bus.gain.value = lift;
      bus.gain.setValueAtTime(lift, start + fadeAt);
      bus.gain.exponentialRampToValueAtTime(0.0001, start + end);
      const comp = ac.createDynamicsCompressor();
      const hall = ac.createConvolver();
      hall.buffer = reverb;
      const wet = ac.createGain();
      wet.gain.value = guqin ? 0.6 : 0.3;
      bus.connect(comp);
      bus.connect(hall).connect(wet).connect(comp);
      comp.connect(volume!);

      voices.forEach((v, i) => {
        const t = start + v.t;
        const src = ac.createBufferSource();
        src.buffer = buffers[i];
        const env = ac.createGain();
        env.gain.setValueAtTime(0, t);
        env.gain.linearRampToValueAtTime(v.level, t + v.attack);
        env.gain.setValueAtTime(v.level, t + v.len);
        env.gain.linearRampToValueAtTime(0, t + v.len + v.release);
        if (v.cutoff) {
          const lowpass = ac.createBiquadFilter();
          lowpass.frequency.value = v.cutoff;
          src.connect(lowpass).connect(env);
        } else src.connect(env);
        env.connect(bus);
        src.start(t);
        src.stop(t + v.len + v.release);
      });

      heads.forEach((h) => (h.style.opacity = '0.35'));
      timers = onsets.map((o, i) => window.setTimeout(() => (heads[i].style.opacity = '1'), (start + o - ac.currentTime) * 1000));
      timers.push(window.setTimeout(finish, (start + end - ac.currentTime) * 1000 + 200));
    };

    card.addEventListener('click', play);
    toggle.addEventListener('click', () => (playing ? stop() : play()));
  </script>
</Base>
