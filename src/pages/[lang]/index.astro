---
import Base from '../../layouts/Base.astro';
import { languages, sections, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang} title={t(lang, 'home.title')} description={t(lang, 'home.tagline')}>
  <h1 class="text-4xl font-bold">{t(lang, 'home.title')}</h1>
  <p class="mt-4 text-lg text-slate-600">{t(lang, 'home.tagline')}</p>
  <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {sections.map((s) => (
      <li>
        <a href={`/${lang}/${s}/`} class="block rounded-lg border border-slate-200 p-5 hover:border-slate-400">
          {t(lang, `nav.${s}`)}
        </a>
      </li>
    ))}
  </ul>
</Base>
