---
import Base from '../../layouts/Base.astro';
import { languages, contactEmail, contactPhone, contactAddress, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const label = 'text-xs font-medium uppercase tracking-widest text-slate-400';
---

<Base lang={lang} title={t(lang, 'contact')} description={t(lang, 'contact.intro')} path="contact">
  <article class="max-w-3xl">
    <p class={label}>RheinWeg</p>
    <h1 class="mt-2 text-3xl font-bold">{t(lang, 'contact')}</h1>
    <p class="mt-3 text-slate-600">{t(lang, 'contact.intro')}</p>

    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      <section>
        <h2 class={label}>{t(lang, 'contact.address')}</h2>
        <address class="mt-3 not-italic leading-relaxed">
          {contactAddress.map((line) => <>{line}<br /></>)}
          {t(lang, 'contact.country')}
        </address>
      </section>
      <div class="space-y-8">
        <section>
          <h2 class={label}>{t(lang, 'contact.email')}</h2>
          <a href={`mailto:${contactEmail}`} class="mt-3 block text-blue-700 hover:underline">{contactEmail}</a>
        </section>
        <section>
          <h2 class={label}>{t(lang, 'contact.phone')}</h2>
          <a href={`tel:${contactPhone.replace(/\s/g, '')}`} class="mt-3 block text-blue-700 hover:underline">{contactPhone}</a>
        </section>
      </div>
    </div>
  </article>
</Base>
